FROM python:3.14-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN useradd --create-home --uid 1000 autoexp && chown -R autoexp:autoexp /app
USER autoexp
EXPOSE 8000
CMD ["uvicorn", "autoexp.server.api:app", "--host", "0.0.0.0", "--port", "8000"]
