# Keep the real .env untracked. Copy values into your deployment secret store.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AUTOEXP_PLANNER_MODEL=deepseek-v4-flash
AUTOEXP_API_TOKEN=replace-with-a-long-random-token
AUTOEXP_MAX_CONCURRENT_RUNS=2
AUTOEXP_JOB_TIMEOUT=3600
# Run the host Worker with these values when using Docker Compose infrastructure.
AUTOEXP_REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_UI_URL=http://localhost:5000
